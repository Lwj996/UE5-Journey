# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Editor =====
.vscode/
.idea/
*.swp
*.swo
*~

# ===== Temp =====
*.tmp
*.log
*.bak
~$*

# ===== Unreal Engine (for future UE sub-projects inside this repo) =====
# Build products
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# UE Generated
*.VC.db
*.opensdf
*.opendb
*.sdf
*.sln
*.suo
*.xcodeproj
*.xcworkspace

# Packages
*.pch
*.obj
*.exe
*.dll
*.pdb

# Crash logs
crashes/
UnrealVS/

# Do NOT ignore Plugins/ (we often want to track plugin source)
!Plugins/

# ===== Node (if any tooling) =====
node_modules/

# ===== Large binaries (force LFS if needed) =====
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
